---

<section class="section contact" aria-labelledby="contact-heading">
  <div class="container contact-row">
    <div>
      <p class="t-label">Contact</p>
      <h2 id="contact-heading" class="t-h2">Building Physical AI workflows?</h2>
    </div>
    <div class="contact-actions">
      <a class="btn btn-primary" href="mailto:hello@puda.co">hello@puda.co</a>
      <a class="btn btn-ghost" href="https://docs.puda.co" target="_blank" rel="noopener noreferrer">
        Read docs
      </a>
    </div>
  </div>
</section>

<style>
  .contact-row {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact .t-label {
    margin-bottom: 1.25rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 60rem) {
    .contact-row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
</style>
