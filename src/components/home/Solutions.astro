---
// The runtime in four verbs, plus where it already runs.
const runtime = [
  { name: "Discover", body: "Agents query machines, state, and commands on demand." },
  { name: "Execute", body: "Validated protocols run through reviewed drivers." },
  { name: "Stream", body: "Live telemetry returns as context for the next action." },
  { name: "Record", body: "Every command, response, and file keeps its provenance." },
];

const facts = [
  { figure: "8", label: "Self-driving labs" },
  { figure: "30", label: "Lab tools on one CLI" },
];
---

<section id="solutions" class="section runtime" aria-labelledby="solutions-heading">
  <div class="container runtime-grid">
    <div class="runtime-intro">
      <p class="t-label">The runtime</p>
      <h2 id="solutions-heading" class="t-h2">Make your machines Physical AI ready.</h2>
      <p class="t-lead">Agnostic to hardware, model provider, and data format.</p>
      <dl class="runtime-facts">
        {
          facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.figure}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <ul class="rule-list runtime-list">
      {
        runtime.map((item) => (
          <li>
            <h3 class="t-title">{item.name}</h3>
            <p class="t-body">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .runtime {
    scroll-margin-top: var(--header-h);
  }

  .runtime-grid {
    display: grid;
    gap: 3rem 5rem;
    grid-template-columns: minmax(0, 1fr);
  }

  .runtime-intro .t-label {
    margin-bottom: 1.25rem;
  }

  .runtime-intro .t-lead {
    margin-top: 1.5rem;
    max-width: 26rem;
  }

  .runtime-facts {
    display: flex;
    gap: 3.5rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
  }

  .runtime-facts div {
    display: flex;
    flex-direction: column-reverse;
  }

  .runtime-facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 2.4rem + 3.2vw, 4.75rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--fg-primary);
  }

  .runtime-facts dt {
    margin-top: 0.75rem;
    font-size: var(--text-small);
    color: var(--fg-secondary);
  }

  .runtime-list > li {
    display: grid;
    gap: 0.35rem 2rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: baseline;
  }

  @media (min-width: 36rem) {
    .runtime-list > li {
      grid-template-columns: 8.5rem minmax(0, 1fr);
    }
  }

  @media (min-width: 60rem) {
    .runtime-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
