---
import config from "../content/config/config.json";

const today = new Date();
const pages = config.nav.filter((item) => item.link !== "/");
const resources = config.contactLinks ?? [];
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<a class="footer-wordmark" href="/">{config.seo.title}</a>
			<p>The hardware harness for Physical AI.</p>
		</div>

		<nav class="footer-col" aria-label="Site">
			<p class="t-label t-label-muted">Site</p>
			<ul>
				{pages.map((item) => (
					<li><a href={item.link}>{item.title}</a></li>
				))}
			</ul>
		</nav>

		<nav class="footer-col" aria-label="Resources">
			<p class="t-label t-label-muted">Resources</p>
			<ul>
				{resources.map((item) => (
					<li>
						<a href={item.link} target="_blank" rel="noopener noreferrer">
							{item.title}
							<span aria-hidden="true">↗</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="footer-col">
			<p class="t-label t-label-muted">Contact</p>
			<ul>
				<li><a href="mailto:hello@puda.co">hello@puda.co</a></li>
			</ul>
		</div>
	</div>

	<div class="container footer-base">
		<span>&copy; {today.getFullYear()} {config.seo.siteOwner}. All rights reserved.</span>
		<span>Physical Unified Device Architecture</span>
	</div>
</footer>

<style>
	.site-footer {
		padding: clamp(3rem, 6vw, 4.5rem) 0 2rem;
		background-color: var(--footer-bg);
		border-top: 1px solid var(--footer-border);
		color: var(--footer-link-fg);
		font-size: var(--text-small);
		transition: background-color 0.25s ease, border-color 0.25s ease;
	}

	.footer-grid {
		display: grid;
		gap: 2.5rem 2rem;
		grid-template-columns: minmax(0, 1fr);
	}

	.footer-wordmark {
		display: inline-block;
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0.01em;
		color: var(--fg-primary);
		text-decoration: none;
	}

	.footer-brand p {
		margin: 0.875rem 0 0;
		max-width: 18rem;
		color: var(--footer-link-fg);
	}

	.footer-col ul {
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.6rem;
	}

	.footer-col a {
		color: var(--footer-link-fg);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.footer-col a:hover {
		color: var(--footer-link-hover);
	}

	.footer-col a span {
		margin-left: 0.15rem;
		font-size: 0.85em;
		opacity: 0.7;
	}

	.footer-base {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		margin-top: clamp(2.5rem, 5vw, 4rem);
		padding-top: 1.5rem;
		border-top: 1px solid var(--footer-border);
		font-size: var(--text-caption);
		color: var(--footer-fg);
	}

	@media (min-width: 40rem) {
		.footer-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	@media (min-width: 60rem) {
		.footer-grid {
			grid-template-columns: minmax(0, 2.2fr) repeat(3, minmax(0, 1fr));
		}
		.footer-brand {
			grid-column: auto;
		}
	}
</style>
