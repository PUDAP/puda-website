---
import config from "../content/config/config.json";
import IconLink from "./react/IconLink";
const today = new Date();
---
	<footer class="copyright-footer">
		&copy; {today.getFullYear()}
		{config.seo.siteOwner}. All rights reserved.
		<div class="social-links">
			{
				config?.contactLinks?.map((link) => {
					return (
						<IconLink {...link} />
					);
				})
			}
		</div>
	</footer>

<style>

	.copyright-footer {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 2.5em 1em;
		background:
			radial-gradient(circle at 50% 0%, rgba(44, 119, 155, 0.12), transparent 42%),
			linear-gradient(180deg, #071116, #030708);
		border-top: 1px solid rgba(91, 164, 194, 0.18);
		color: rgba(181, 193, 196, 0.72);
		text-align: center;
		transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
	}

	.copyright-footer::before {
		content: "";
		position: absolute;
		z-index: -1;
		inset: 0;
		background-image:
			linear-gradient(rgba(73, 137, 163, 0.04) 1px, transparent 1px),
			linear-gradient(90deg, rgba(73, 137, 163, 0.035) 1px, transparent 1px);
		background-size: 120px 120px;
		mask-image: linear-gradient(to bottom, #000, transparent);
		-webkit-mask-image: linear-gradient(to bottom, #000, transparent);
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}

	.social-links a {
		text-decoration: none;
		color: #75a9bb;
		transition: color 0.2s ease, filter 0.2s ease, transform 0.2s ease;
	}

	.social-links a:hover {
		color: #e8ff9c;
		filter: drop-shadow(0 0 0.55rem rgba(232, 255, 156, 0.24));
		transform: translateY(-0.12rem);
	}

	:global([data-theme="light"]) .copyright-footer {
		background:
			radial-gradient(circle at 50% 0%, rgba(35, 95, 118, 0.08), transparent 42%),
			linear-gradient(180deg, #eef3f2, #f5f7f2);
		border-top-color: rgba(35, 95, 118, 0.14);
		color: rgba(13, 17, 13, 0.56);
	}

	:global([data-theme="light"]) .social-links a {
		color: #39758a;
	}

	:global([data-theme="light"]) .social-links a:hover {
		color: #4f7000;
	}

	.tina-footer {
		display: flex;
		justify-content: center;
		position: relative;
		width: 100%;
		overflow: hidden;
		background-image: linear-gradient(60deg, #000000 0%,  #EC4815 50%, #000000 100%);
		padding: 1.5em 0;
	}

	.tina-banner-content {
		display: flex;
		align-items: center;
		gap: 0.5em;
		font-size: 1.2em;
		position: relative;
		z-index: 2;
	}

	.tina-footer::before {
		content: '';
		position: absolute;
		top: 0;
		left: -50%;
		width: 200%;
		height: 100%;
		background-image: linear-gradient(60deg, #1F1E24 25%,   #EC4815 50%, #1F1E24 75%);
		transition: transform 1s ease-in-out;
		z-index: 1;
	}

	.tina-footer:has(.tina-banner-content a:hover)::before {
		transform: scaleX(2);
	}

	.tina-banner-content img {
		width: 30px;
		height: auto;
	}

	.tina-banner-content a {
		color: white;
		text-decoration: none;
		padding-top: 0.5em;
		font-weight: bold;
	}
</style>
