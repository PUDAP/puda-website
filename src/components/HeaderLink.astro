---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const normalizePath = (value: string) => {
	const normalized = value.replace(import.meta.env.BASE_URL, '').replace(/\/+$/, '');
	return normalized || '/';
};
const pathname = normalizePath(Astro.url.pathname);
const linkPath = normalizePath(String(href ?? '/'));
const currentSection = pathname.split('/').filter(Boolean)[0] ?? '';
const linkSection = linkPath.split('/').filter(Boolean)[0] ?? '';
const isActive =
	linkPath === pathname ||
	(linkPath !== '/' && linkSection !== '' && linkSection === currentSection);
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
