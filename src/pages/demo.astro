---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import VideoPlaceholder from "../components/VideoPlaceholder.astro";

const LIVE_DASHBOARD_URL = "https://demo.puda.co/d/bears/bears";

const videos = [
  {
    embed: "https://youtu.be/0cpDzuESnMQ",
    title: "PUDA demo video",
    caption: "Controlling lab devices using Telegram",
    bilibili:
      "https://www.bilibili.com/video/BV1o2hg6zEvK/?share_source=copy_web&vd_source=4c0731b7e6c39bda92a5e1d7cef97270",
    bilibiliTitle: "PUDA 操控实验仪器演示",
  },
  {
    embed: "https://www.youtube.com/embed/rOKpWaq1ALw",
    title: "PUDA demo video 2",
    caption: "Controlling lab devices using Cursor",
    bilibili:
      "https://www.bilibili.com/video/BV1RShg6qErJ/?share_source=copy_web&vd_source=4c0731b7e6c39bda92a5e1d7cef97270",
    bilibiliTitle: "在编程界面用PUDA操控实验仪器",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="PUDA Demo"
      description="Watch PUDA control lab devices and open live BEARS telemetry."
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="section page-top" aria-labelledby="demo-heading">
        <div class="container">
          <p class="t-label">Demo</p>
          <h1 id="demo-heading" class="t-h1">See PUDA in motion.</h1>

          <div class="video-grid">
            {
              videos.map((video) => (
                <figure class="video-item">
                  <VideoPlaceholder embedSrc={video.embed} title={video.title} />
                  <figcaption>
                    <span class="t-title">{video.caption}</span>
                    <a
                      class="link-arrow"
                      href={video.bilibili}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={video.bilibiliTitle}
                    >
                      Watch on Bilibili
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 17 17 7"></path>
                        <path d="M7 7h10v10"></path>
                      </svg>
                    </a>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <section id="live" class="section live" aria-labelledby="live-heading">
        <div class="container live-row">
          <div>
            <p class="t-label">Live data</p>
            <h2 id="live-heading" class="t-h2">See the lab in real time.</h2>
            <p class="t-lead">
              Live production data from NUS, NTU and A*STAR IFIM in Singapore.
            </p>
          </div>
          <a
            class="btn btn-primary"
            href={LIVE_DASHBOARD_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Open dashboard
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7"></path>
              <path d="M7 7h10v10"></path>
            </svg>
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .video-grid {
    display: grid;
    gap: 3rem 2rem;
    grid-template-columns: minmax(0, 1fr);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .video-item {
    margin: 0;
  }

  .video-item figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
  }

  .live {
    scroll-margin-top: var(--header-h);
  }

  .live-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
  }

  .live .t-label {
    margin-bottom: 1.25rem;
  }

  .live .t-lead {
    margin-top: 1.25rem;
    max-width: 32rem;
  }

  @media (min-width: 60rem) {
    .video-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .live-row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
</style>
