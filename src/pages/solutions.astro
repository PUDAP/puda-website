---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const solutions = [
  {
    label: "Machine execution",
    title: "Run physical protocols through a controlled runtime",
    body:
      "Coordinate machines, robots, sensors, edge clients, and human approvals through typed commands that can be reviewed before and after execution.",
  },
  {
    label: "Data trails",
    title: "Capture every action, measurement, and decision",
    body:
      "Keep the agent conversation, requested tools, machine commands, run state, raw outputs, and derived files aligned in one inspectable trail.",
  },
  {
    label: "Closed loop",
    title: "Turn analysis into the next action",
    body:
      "Feed provenance-backed results into analysis and planning so the next protocol, task, or control decision is grounded in what actually happened.",
  },
];

const useCases = [
  {
    title: "Robotic workcells",
    image: "/images/applications/robotic-workcells.png",
    body:
      "Coordinate arms, grippers, sensors, and inspection tools while preserving the full command and measurement history.",
  },
  {
    title: "Autonomous test systems",
    image: "/images/applications/autonomous-test-systems.png",
    body:
      "Run test stands, characterization equipment, and validation rigs with repeatable protocols and traceable outputs.",
  },
  {
    title: "Industrial pilots",
    image: "/images/applications/industrial-pilots.png",
    body:
      "Connect AI planning to machines on pilot lines where every action needs operator review, limits, and evidence.",
  },
  {
    title: "Field operations",
    image: "/images/applications/field-operations.png",
    body:
      "Operate distributed physical assets through edge clients while keeping connectivity gaps, approvals, and data capture visible.",
  },
  {
    title: "Closed-loop optimization",
    image: "/images/applications/closed-loop-optimization.png",
    body:
      "Analyze run results and feed verified outcomes into the next action without losing provenance between iterations.",
  },
  {
    title: "Human-in-the-loop control",
    image: "/images/applications/human-in-the-loop-control.png",
    body:
      "Let agents propose actions while people approve critical steps and audit what happened afterward.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="PUDA Solutions"
      description="End-to-end Physical AI workflows from machine execution to data provenance, analysis, and closed-loop operation."
    />
  </head>

  <body class="solutions-body">
    <Header />

    <main class="solutions-main">
      <div class="solutions-grid-bg" />
      <div class="solutions-radial-bg" />
      <div class="solutions-vignette" />
      <div class="solutions-circuit-bg" aria-hidden="true" />

      <section class="solutions-hero">
        <p class="solutions-label">Solutions</p>
        <div class="solutions-hero-grid">
          <h1 class="solutions-heading">
            Make your machines Physical AI ready
          </h1>
          <div class="solutions-intro">
            <p>
              PUDA gives teams the runtime layer that makes physical systems
              agent-ready: execute typed machine actions, preserve the data
              trail, prove where results came from, analyze outcomes, and close
              the loop into the next physical action.
            </p>
            <div class="solutions-actions">
              <a class="solutions-primary" href="/demo">Explore demo</a>
              <a class="solutions-secondary" href="https://docs.puda.co" target="_blank" rel="noopener noreferrer">
                Read docs
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="solutions-band">
        <div class="solutions-section-head">
          <p class="solutions-label">Use cases</p>
          <h2>The Physical AI lifecycle in one system</h2>
        </div>

        <div class="solutions-cards">
          {
            solutions.map((solution) => (
              <article class="solutions-card">
                <p>{solution.label}</p>
                <h3>{solution.title}</h3>
                <span>{solution.body}</span>
              </article>
            ))
          }
        </div>
      </section>

      <section class="solutions-use-cases">
        <div class="solutions-section-head">
          <p class="solutions-label">Applications</p>
          <h2>Use cases for Physical AI teams</h2>
        </div>

        <div class="solutions-use-case-grid">
          {
            useCases.map((useCase) => (
              <article class="solutions-use-case">
                <img src={useCase.image} alt="" loading="lazy" />
                <div class="solutions-use-case-copy">
                  <h3>{useCase.title}</h3>
                  <p>{useCase.body}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="solutions-contact">
        <p class="solutions-label">Contact us</p>
        <div class="solutions-contact-row">
          <h2>Building Physical AI workflows?</h2>
          <a class="solutions-contact-link" href="mailto:bearspuda@gmail.com">
            bearspuda@gmail.com
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .solutions-body {
    --solutions-surface: #030708;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--solutions-surface);
    color: var(--fg-primary);
  }

  [data-theme="light"] .solutions-body {
    --solutions-surface: #f5f7f2;
  }

  .solutions-main {
    flex: 1;
    position: relative;
    overflow: hidden;
    padding: 5rem 1.5rem 6rem;
    background-color: var(--solutions-surface);
  }

  .solutions-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(73, 137, 163, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(73, 137, 163, 0.045) 1px, transparent 1px);
    background-size: 120px 120px;
    opacity: 0.42;
    pointer-events: none;
  }

  .solutions-radial-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 12% 10%, rgba(35, 95, 118, 0.1), transparent 34%),
      radial-gradient(circle at 86% 18%, rgba(44, 119, 155, 0.1), transparent 32%),
      radial-gradient(circle at 50% 100%, rgba(25, 70, 88, 0.07), transparent 38%);
    pointer-events: none;
  }

  .solutions-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 0%, rgba(0, 0, 0, 0.24) 48%, rgba(0, 0, 0, 0.76) 100%);
    pointer-events: none;
  }

  .solutions-circuit-bg {
    position: absolute;
    inset: 36rem 0 0;
    z-index: 5;
    pointer-events: none;
    opacity: 0.38;
    background-image:
      url("/images/solutions-circuit-side.png"),
      url("/images/solutions-circuit-side.png"),
      url("/images/solutions-circuit-side.png");
    background-repeat: no-repeat;
    background-position:
      left -5rem top 3rem,
      right -5rem top 42rem,
      left -7rem top 88rem;
    background-size:
      clamp(14rem, 19vw, 22rem) auto,
      clamp(14rem, 19vw, 22rem) auto,
      clamp(12rem, 16vw, 19rem) auto;
    mix-blend-mode: screen;
    mask-image:
      linear-gradient(to bottom, transparent 0, #000 5rem, #000 calc(100% - 8rem), transparent 100%),
      linear-gradient(to right, #000 0, transparent 28%, transparent 72%, #000 100%);
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(to bottom, transparent 0, #000 5rem, #000 calc(100% - 8rem), transparent 100%),
      linear-gradient(to right, #000 0, transparent 28%, transparent 72%, #000 100%);
    -webkit-mask-composite: source-in;
  }

  [data-theme="light"] .solutions-grid-bg,
  [data-theme="light"] .solutions-radial-bg,
  [data-theme="light"] .solutions-vignette {
    display: none;
  }

  [data-theme="light"] .solutions-circuit-bg {
    opacity: 0.12;
    mix-blend-mode: multiply;
  }

  .solutions-hero,
  .solutions-band,
  .solutions-use-cases,
  .solutions-contact {
    position: relative;
    z-index: 10;
    width: min(100%, 72rem);
    margin: 0 auto;
  }

  .solutions-hero {
    isolation: isolate;
    min-height: 36rem;
    width: calc(100% + 3rem);
    max-width: none;
    margin: -5rem -1.5rem -3.5rem;
    padding: clamp(7rem, 10vw, 9rem) max(1.5rem, calc((100vw - 72rem) / 2 + 1.5rem)) clamp(5rem, 8vw, 7rem);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .solutions-hero::before,
  .solutions-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .solutions-hero::before {
    z-index: -2;
    background: #060a0c url("/images/solutions-physical-ai-hero.png") 58% center / cover no-repeat;
  }

  .solutions-hero::after {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(4, 7, 8, 0.94) 0%, rgba(4, 7, 8, 0.73) 43%, rgba(4, 7, 8, 0.12) 82%),
      linear-gradient(0deg, var(--solutions-surface) 0%, rgba(3, 7, 8, 0.9) 12%, transparent 34%, transparent 72%, rgba(3, 7, 8, 0.25) 100%);
  }

  .solutions-hero .solutions-label,
  .solutions-hero .solutions-heading,
  .solutions-hero .solutions-intro,
  .solutions-hero .solutions-secondary {
    color: #f3f5ef;
  }

  .solutions-hero .solutions-label {
    color: #e8ff9c;
  }

  .solutions-hero .solutions-secondary {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(5, 8, 9, 0.24);
    backdrop-filter: blur(0.5rem);
  }

  .solutions-hero .solutions-secondary:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .solutions-hero-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 1fr);
    align-items: center;
    width: 100%;
  }

  .solutions-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.42em;
    color: var(--accent);
    margin: 0 0 1.25rem;
  }

  .solutions-heading {
    font-size: clamp(3rem, 7.5vw, 6.5rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.065em;
    color: var(--fg-primary);
    margin: 0;
    max-width: 54rem;
  }

  .solutions-intro {
    color: var(--fg-secondary);
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .solutions-intro p {
    margin: 0;
  }

  .solutions-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .solutions-primary,
  .solutions-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.85rem 1.2rem;
    font-size: 0.9rem;
    line-height: 1;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .solutions-primary {
    background: var(--accent);
    color: var(--accent-fg);
  }

  .solutions-primary:hover {
    background: #ffffff;
  }

  [data-theme="light"] .solutions-primary:hover {
    background: #d0f060;
  }

  .solutions-secondary {
    border: 1px solid var(--cta-border);
    color: var(--cta-fg);
  }

  .solutions-secondary:hover {
    background: var(--cta-hover-bg);
  }

  .solutions-band,
  .solutions-use-cases,
  .solutions-contact {
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    padding: 3.5rem 0;
  }

  .solutions-band {
    border-top: 0;
  }

  [data-theme="light"] .solutions-band,
  [data-theme="light"] .solutions-use-cases,
  [data-theme="light"] .solutions-contact {
    border-top-color: rgba(0, 0, 0, 0.09);
  }

  [data-theme="light"] .solutions-band {
    border-top: 0;
  }

  .solutions-section-head {
    max-width: 42rem;
    margin-bottom: 1.75rem;
  }

  .solutions-section-head h2 {
    color: var(--fg-primary);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.055em;
    margin: 0;
  }

  .solutions-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .solutions-card {
    min-height: 17rem;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(91, 164, 194, 0.2);
    border-radius: 0.75rem;
    padding: 1.4rem;
    background: linear-gradient(145deg, rgba(17, 34, 42, 0.96), rgba(7, 17, 22, 0.96));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }

  .solutions-card:hover {
    border-color: rgba(232, 255, 156, 0.42);
    background: linear-gradient(145deg, rgba(20, 42, 50, 0.98), rgba(8, 20, 25, 0.98));
    transform: translateY(-0.2rem);
  }

  [data-theme="light"] .solutions-card {
    border-color: rgba(0, 0, 0, 0.08);
    background: linear-gradient(145deg, #ffffff, #eef3f2);
  }

  [data-theme="light"] .solutions-card:hover {
    border-color: rgba(67, 114, 0, 0.24);
    background: #ffffff;
  }

  .solutions-card p {
    color: #e8ff9c;
    font-size: 0.68rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }

  .solutions-card h3 {
    color: #f3f7f5;
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: -0.025em;
    margin: 0 0 1rem;
  }

  .solutions-card span {
    color: #aebcc0;
    font-size: 0.95rem;
    line-height: 1.7;
    margin-top: auto;
  }

  [data-theme="light"] .solutions-card p {
    color: #4f7000;
  }

  [data-theme="light"] .solutions-card h3 {
    color: #111510;
  }

  [data-theme="light"] .solutions-card span {
    color: #545b52;
  }

  .solutions-use-case-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  [data-theme="light"] .solutions-use-case-grid {
    background: transparent;
  }

  .solutions-use-case {
    min-height: 24rem;
    background: rgba(3, 7, 8, 0.84);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 0.75rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .solutions-use-case img {
    display: block;
    width: 100%;
    height: 15rem;
    object-fit: cover;
    filter: saturate(0.82) brightness(0.82);
    transition: transform 0.5s ease, filter 0.5s ease;
  }

  .solutions-use-case:hover img {
    transform: scale(1.025);
    filter: saturate(0.95) brightness(0.9);
  }

  .solutions-use-case-copy {
    padding: 1.35rem;
  }

  [data-theme="light"] .solutions-use-case {
    background: rgba(245, 247, 242, 0.96);
    border-color: rgba(0, 0, 0, 0.09);
  }

  .solutions-use-case h3 {
    color: var(--fg-primary);
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }

  .solutions-use-case p {
    color: var(--fg-secondary);
    font-size: 0.94rem;
    line-height: 1.7;
    margin: 0;
  }

  .solutions-contact {
    padding-bottom: 0;
  }

  .solutions-contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .solutions-contact h2 {
    color: var(--fg-primary);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.055em;
    margin: 0;
  }

  .solutions-contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--cta-border);
    border-radius: 999px;
    color: var(--cta-fg);
    font-family: monospace;
    font-size: 0.95rem;
    line-height: 1;
    padding: 0.9rem 1.2rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .solutions-contact-link:hover {
    background: var(--cta-hover-bg);
    border-color: var(--accent);
    color: var(--fg-primary);
  }

  @media (max-width: 900px) {
    .solutions-circuit-bg {
      display: none;
    }

    .solutions-hero {
      min-height: 34rem;
      padding-top: 7rem;
      padding-bottom: 4.5rem;
    }

    .solutions-hero::before {
      background-position: 62% center;
    }

    .solutions-hero::after {
      background: rgba(4, 7, 8, 0.78);
    }

    .solutions-hero-grid {
      grid-template-columns: 1fr;
    }

    .solutions-cards {
      grid-template-columns: 1fr;
    }

    .solutions-use-case-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .solutions-card,
    .solutions-use-case {
      min-height: auto;
    }

    .solutions-contact-row {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 600px) {
    .solutions-use-case-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
