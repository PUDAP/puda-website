---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroBackdrop from '../components/home/HeroBackdrop.astro';
import CliAnimation from '../components/home/CliAnimation.astro';
import TrustBar from '../components/home/TrustBar.astro';
import NvidiaInception from '../components/home/NvidiaInception.astro';
import Loop from '../components/home/Loop.astro';
import Solutions from '../components/home/Solutions.astro';
import DemoReel from '../components/home/DemoReel.astro';
import UseCases from '../components/home/UseCases.astro';
import Contact from '../components/home/Contact.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="PUDA — Physical Unified Device Architecture"
      description="PUDA is the hardware harness for Physical AI: instruments and robots become CLI commands that AI agents can observe, act on, and learn from."
    />
  </head>
  <body>

    <Header />

    <main>
      <!-- Hero -->
      <section class="hero">
        <HeroBackdrop />

        <div id="top" class="container hero-inner">
          <div class="hero-copy">
            <p class="t-label">Physical Unified Device Architecture</p>
            <h1 class="t-hero">The hardware harness for Physical AI</h1>
            <p class="t-lead">
              PUDA turns instruments and robots into CLI commands, so AI agents can
              observe, act, and learn from the physical world.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="/demo">Watch demo</a>
              <a
                class="btn btn-ghost"
                href="https://arxiv.org/abs/2607.26464"
                target="_blank"
                rel="noopener noreferrer"
              >
                Read the paper
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7"></path>
                  <path d="M7 7h10v10"></path>
                </svg>
              </a>
            </div>
          </div>

          <div class="hero-terminal">
            <CliAnimation />
          </div>
        </div>
      </section>

      <TrustBar />

      <NvidiaInception />

      <Loop />

      <Solutions />

      <DemoReel />

      <UseCases />

      <Contact />
    </main>

    <Footer />

  </body>
</html>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    margin-top: calc(var(--header-h) * -1);
    padding-top: var(--header-h);
    overflow: hidden;
    background-color: var(--bg-primary);
    transition: background-color 0.25s ease;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 3rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .hero-copy .t-label {
    margin-bottom: 1.5rem;
  }

  .hero-copy .t-lead {
    max-width: 31rem;
    margin-top: 1.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero-terminal {
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .hero-inner {
      gap: 4rem;
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    }
  }

  /* A short, staggered entrance. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > *,
    .hero-terminal {
      animation: hero-rise 0.85s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .hero-copy > :nth-child(2) {
      animation-delay: 0.06s;
    }

    .hero-copy > :nth-child(3) {
      animation-delay: 0.12s;
    }

    .hero-copy > :nth-child(4) {
      animation-delay: 0.18s;
    }

    .hero-terminal {
      animation-delay: 0.22s;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
</style>
