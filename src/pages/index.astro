---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MosaicHero from '../components/home/MosaicHero.astro';
import CliAnimation from '../components/home/CliAnimation.astro';
import TrustBar from '../components/home/TrustBar.astro';
import NvidiaInception from '../components/home/NvidiaInception.astro';
import Solutions from '../components/home/Solutions.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="PUDA — Physical Unified Device Architecture"
      description="PUDA connects AI agents to instruments, robots, datastreams, approvals, and audit trails."
    />
  </head>
  <body class="min-h-screen flex flex-col">

    <Header />

    <!-- Hero -->
    <section class="hero-section relative min-h-[100svh]">
      <MosaicHero />

      <div id="top" class="relative z-10 mx-auto flex min-h-[100svh] max-w-7xl flex-col items-center justify-center px-6 py-20 text-center">
        <h1 class="hero-title max-w-6xl text-balance text-4xl font-normal tracking-[-0.065em] md:text-5xl lg:text-[4.8rem] lg:leading-[0.94]">
          The hardware harness for Physical AI
        </h1>
        <p class="hero-subtitle mt-5 max-w-3xl text-balance text-base leading-7 md:text-xl md:leading-8">
          PUDA (Physical Unified Device Architecture) connects AI agents to instruments, robots, datastreams, approvals, and audit trails.
        </p>
        <CliAnimation />
        <div class="mt-9 flex flex-col items-center gap-3 sm:flex-row">
          <a class="cta-primary rounded-full px-6 py-3 text-sm font-medium transition" href="/demo">
            Watch demo
          </a>
          <a
            class="cta-secondary rounded-full border px-6 py-3 text-sm transition"
            href="/demo#live"
          >
            Explore demo
          </a>
          <a
            class="cta-secondary rounded-full border px-6 py-3 text-sm transition"
            href="https://arxiv.org/abs/2607.26464"
            target="_blank"
            rel="noopener noreferrer"
          >
            Read paper
          </a>
        </div>
      </div>
    </section>

    <TrustBar />

    <NvidiaInception />

    <Solutions />

    <Footer />

  </body>
</html>

<style is:global>
  body {
    background-color: var(--bg-primary);
    color: var(--fg-primary);
    transition: background-color 0.25s ease, color 0.2s ease;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .hero-section {
    background-color: var(--bg-primary);
    color: var(--fg-primary);
    transition: background-color 0.25s ease;
  }

  .hero-title {
    color: var(--fg-primary);
  }

  .hero-subtitle {
    color: var(--fg-secondary);
  }

  .cta-primary {
    background-color: var(--accent);
    color: var(--accent-fg);
  }
  .cta-primary:hover {
    background-color: #ffffff;
  }
  [data-theme="light"] .cta-primary:hover {
    background-color: #d0f060;
  }

  .cta-secondary {
    border-color: var(--cta-border);
    color: var(--cta-fg);
  }
  .cta-secondary:hover {
    background-color: var(--cta-hover-bg);
  }
</style>
