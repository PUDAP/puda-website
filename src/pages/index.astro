---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhysicalAIHero from '../components/home/PhysicalAIHero.astro';
import PhysicalAICli from '../components/home/PhysicalAICli.astro';
import VideoPlaceholder from '../components/VideoPlaceholder.astro';
const DEMO_VIDEO_EMBED =
  "https://youtu.be/0cpDzuESnMQ";
const SECOND_DEMO_VIDEO_EMBED =
  "https://www.youtube.com/embed/rOKpWaq1ALw";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="PUDA — Physical Unified Device Architecture"
      description="PUDA connects AI agents to instruments, robots, datastreams, approvals, and audit trails."
    />
  </head>
  <body class="home-body min-h-screen flex flex-col">

    <Header />

    <!-- Hero -->
    <section class="hero-section relative min-h-[100svh]">
      <PhysicalAIHero />

      <div id="top" class="relative z-10 mx-auto flex min-h-[100svh] max-w-7xl flex-col items-center justify-center px-6 py-20 text-center">
        <h1 class="hero-title max-w-6xl text-balance text-4xl font-normal tracking-[-0.065em] md:text-5xl lg:text-[4.8rem] lg:leading-[0.94]">
          The runtime environment for Physical AI
        </h1>
        <p class="hero-subtitle mt-5 max-w-3xl text-balance text-base leading-7 md:text-xl md:leading-8">
          PUDA (Physical Unified Device Architecture) connects AI agents to instruments, robots, datastreams, approvals, and audit trails.
        </p>
        <PhysicalAICli />
        <div class="mt-9 flex flex-col items-center gap-3 sm:flex-row">
          <a class="cta-primary rounded-full px-6 py-3 text-sm font-medium transition" href="#video">
            Watch the demo
          </a>
          <a class="cta-secondary rounded-full border px-6 py-3 text-sm transition" href="https://demo.puda.co">
            Explore demo
          </a>
        </div>
      </div>
    </section>

    <!-- Video demo -->
    <section id="video" class="video-section flex min-h-[100svh] items-center px-6 py-16 md:px-12 lg:px-20">
      <div class="home-circuit-bg" aria-hidden="true"></div>
      <div class="mx-auto w-full max-w-[92rem]">
        <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between lg:mb-10">
          <div>
            <p class="demo-label mb-4 text-xs uppercase tracking-[0.42em]">Demo</p>
            <h2 class="video-heading text-5xl font-normal tracking-[-0.065em] md:text-7xl">
              See PUDA in motion.
            </h2>
          </div>
        </div>
        <p class="video-description mb-2 text-base md:text-lg">
          Controlling lab devices using telegram
        </p>
        <p class="mb-4 text-sm md:text-base">
          <a
            class="video-link transition"
            href="https://www.bilibili.com/video/BV1o2hg6zEvK/?share_source=copy_web&vd_source=4c0731b7e6c39bda92a5e1d7cef97270"
            target="_blank"
            rel="noopener noreferrer"
          >
            Watch the video on Bilibili: 【PUDA 操控实验仪器演示】
          </a>
        </p>
        <VideoPlaceholder embedSrc={DEMO_VIDEO_EMBED} title="PUDA demo video" />
        <div class="mt-10 md:mt-14">
          <p class="video-description mb-4 text-base md:text-lg">
            Controlling lab devices using cursor
          </p>
          <VideoPlaceholder embedSrc={SECOND_DEMO_VIDEO_EMBED} title="PUDA demo video 2" />
        </div>
      </div>
    </section>

    <Footer />

  </body>
</html>

<style is:global>
  body {
    background-color: #030708;
    color: var(--fg-primary);
    transition: background-color 0.25s ease, color 0.2s ease;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .hero-section {
    background-color: #030708;
    color: var(--fg-primary);
    transition: background-color 0.25s ease;
  }

  .hero-title {
    color: #f3f5ef;
    text-shadow: 0 1rem 4rem rgba(0, 0, 0, 0.55);
  }

  .hero-subtitle {
    color: #b5c1c4;
  }

  .cta-primary {
    background-color: #e8ff9c;
    color: #071014;
  }
  .cta-primary:hover {
    background-color: #ffffff;
  }
  [data-theme="light"] .cta-primary:hover {
    background-color: #d0f060;
  }

  .cta-secondary {
    border-color: rgba(125, 190, 215, 0.3);
    color: #e5eef0;
    background: rgba(7, 17, 22, 0.56);
    backdrop-filter: blur(0.6rem);
  }
  .cta-secondary:hover {
    background-color: var(--cta-hover-bg);
  }

  .video-section {
    flex: 1;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 88% 10%, rgba(44, 119, 155, 0.1), transparent 30%),
      linear-gradient(rgba(73, 137, 163, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(73, 137, 163, 0.035) 1px, transparent 1px),
      #030708;
    background-size: auto, 120px 120px, 120px 120px, auto;
    border-top: 1px solid rgba(91, 164, 194, 0.12);
    transition: background-color 0.25s ease;
  }

  .demo-label {
    color: #e8ff9c;
  }

  .video-heading {
    color: #f3f5ef;
  }

  .video-description {
    color: #aebcc0;
  }

  .video-link {
    color: #e8ff9c;
    text-decoration: underline;
    text-decoration-color: rgba(232, 255, 156, 0.45);
    text-underline-offset: 0.25rem;
  }

  .video-link:hover {
    color: #ffffff;
    text-decoration-color: currentColor;
  }

  .video-section > div:not(.home-circuit-bg) {
    position: relative;
    z-index: 2;
  }

  .home-circuit-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.28;
    background-image:
      url("/images/solutions-circuit-side.png"),
      url("/images/solutions-circuit-side.png");
    background-repeat: no-repeat;
    background-position: left -6rem top 8rem, right -6rem top 55rem;
    background-size: clamp(14rem, 19vw, 22rem) auto;
    mix-blend-mode: screen;
    mask-image: linear-gradient(to right, #000, transparent 28%, transparent 72%, #000);
    -webkit-mask-image: linear-gradient(to right, #000, transparent 28%, transparent 72%, #000);
  }

  .video-section .relative.w-full.overflow-hidden {
    border: 1px solid rgba(91, 164, 194, 0.2);
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.35);
  }

  [data-theme="light"] body,
  [data-theme="light"] .hero-section {
    background-color: #f5f7f2;
  }

  [data-theme="light"] .video-section {
    background: #f5f7f2;
  }

  [data-theme="light"] .hero-title,
  [data-theme="light"] .video-heading {
    color: #111510;
    text-shadow: none;
  }

  [data-theme="light"] .hero-subtitle,
  [data-theme="light"] .video-description {
    color: #545b52;
  }

  [data-theme="light"] .video-link {
    color: #516a00;
    text-decoration-color: rgba(81, 106, 0, 0.4);
  }

  [data-theme="light"] .video-link:hover {
    color: #263300;
  }

  [data-theme="light"] .home-circuit-bg {
    opacity: 0.1;
    mix-blend-mode: multiply;
  }
</style>
