---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import config from "../../content/config/config.json";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
	date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
		timeZone: "UTC",
	});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${config.seo.title} — Blog`} description={config.seo.description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="section page-top" aria-labelledby="blog-heading">
				<div class="container">
					<p class="t-label">Blog</p>
					<h1 id="blog-heading" class="t-h1">Research and field notes</h1>

					<ul class="post-list">
						{
							posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}`}>
										<time class="post-date" datetime={post.data.pubDate.toISOString()}>
											{formatDate(post.data.pubDate)}
										</time>
										<div class="post-summary">
											<h2 class="t-h3">{post.data.title}</h2>
											{post.data.description && <p class="t-body">{post.data.description}</p>}
										</div>
										<svg class="post-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M5 12h14" />
											<path d="m13 6 6 6-6 6" />
										</svg>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-list {
		margin: clamp(2.5rem, 5vw, 4rem) 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line);
	}

	.post-list li {
		border-bottom: 1px solid var(--line);
	}

	.post-list a {
		display: grid;
		gap: 0.75rem 2.5rem;
		grid-template-columns: minmax(0, 1fr);
		align-items: baseline;
		padding-block: 1.75rem 2rem;
		color: inherit;
		text-decoration: none;
	}

	.post-date {
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--fg-tertiary);
	}

	.post-summary h2 {
		transition: color 0.2s ease;
	}

	.post-summary p {
		max-width: 44rem;
		margin-top: 0.6rem;
	}

	.post-arrow {
		display: none;
		width: 1.25rem;
		height: 1.25rem;
		align-self: center;
		color: var(--fg-tertiary);
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.post-list a:hover .post-arrow {
		color: var(--accent);
		transform: translateX(0.35rem);
	}

	.post-list a:hover h2 {
		color: var(--accent);
	}

	@media (min-width: 48rem) {
		.post-list a {
			grid-template-columns: 9rem minmax(0, 1fr) auto;
		}

		.post-arrow {
			display: block;
		}
	}
</style>
