---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const principles = [
  {
    name: "Open source",
    body: "Core runtime and edge adapters are MIT-licensed and developed in the open.",
    link: { label: "github.com/PUDAP", href: "https://github.com/PUDAP" },
  },
  {
    name: "Inspectable",
    body: "Every agent turn, tool call, and hardware action is recorded and replayable.",
  },
  {
    name: "Open research",
    body: "PUDA: An AI-Native Hardware Harness for Self-Driving Laboratories.",
    link: { label: "arXiv:2607.26464", href: "https://arxiv.org/abs/2607.26464" },
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="PUDA About"
      description="Learn about PUDA, the runtime environment for Physical AI."
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="section page-top" aria-labelledby="about-heading">
        <div class="container about-intro">
          <p class="t-label">About</p>
          <h1 id="about-heading" class="t-h1">
            The runtime environment for Physical AI
          </h1>
          <p class="t-lead">
            PUDA (Physical Unified Device Architecture) is an open platform that connects
            AI agents to instruments and robots, for research labs and automation teams
            who need reliable, inspectable control over physical hardware.
          </p>
        </div>
      </section>

      <section class="section" aria-labelledby="mission-heading">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="t-label">Mission</p>
              <h2 id="mission-heading" class="t-h2">
                An open, connected, and intelligent physical world.
              </h2>
            </div>
            <p class="t-lead">
              Physical AI is only as trustworthy as the layer beneath it. PUDA makes every
              action traceable, from the model's request to the instrument command.
            </p>
          </div>

          <ul class="rule-list principle-list">
            {
              principles.map((item) => (
                <li>
                  <h3 class="t-title">{item.name}</h3>
                  <p class="t-body">{item.body}</p>
                  {item.link && (
                    <a
                      class="link-arrow"
                      href={item.link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="t-mono">{item.link.label}</span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 17 17 7" />
                        <path d="M7 7h10v10" />
                      </svg>
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="section" aria-labelledby="about-contact-heading">
        <div class="container contact-row">
          <div>
            <p class="t-label">Contact</p>
            <h2 id="about-contact-heading" class="t-h2">
              Questions, collaborations, or bug reports.
            </h2>
          </div>
          <div class="contact-actions">
            <a class="btn btn-primary" href="mailto:hello@puda.co">hello@puda.co</a>
            <a
              class="btn btn-ghost"
              href="https://github.com/PUDAP"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7"></path>
                <path d="M7 7h10v10"></path>
              </svg>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .about-intro .t-h1 {
    max-width: 16ch;
  }

  .about-intro .t-lead {
    max-width: 40rem;
    margin-top: 1.75rem;
  }

  .principle-list > li {
    display: grid;
    gap: 0.5rem 2rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: baseline;
  }

  .principle-list .link-arrow {
    justify-self: start;
  }

  .contact-row {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact-row .t-label {
    margin-bottom: 1.25rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 48rem) {
    .principle-list > li {
      grid-template-columns: 11rem minmax(0, 1fr) auto;
    }

    .principle-list .link-arrow {
      justify-self: end;
    }
  }

  @media (min-width: 60rem) {
    .contact-row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
</style>
