---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="PUDA About"
      description="Learn about PUDA, the runtime environment for Physical AI."
    />
  </head>

  <body class="about-body">
    <Header />

    <main class="about-main">
      <!-- Background layers (matching demo/home aesthetic) -->
      <div class="about-grid-bg" />
      <div class="about-radial-bg" />
      <div class="about-vignette" />
      <div class="about-circuit-bg" aria-hidden="true" />

      <div class="about-content">
        <section class="about-hero">
          <!-- Label -->
          <p class="about-label">About</p>

          <!-- Heading -->
          <h1 class="about-heading">
            The runtime environment<br />for Physical AI
          </h1>

          <!-- Description -->
          <p class="about-description">
            PUDA (Physical Unified Device Architecture) is an open platform that
            connects AI agents to instruments, robots, datastreams, approvals, and
            audit trails. Built for research labs and automation teams who need
            reliable, inspectable control over physical hardware.
          </p>
        </section>

        <hr class="about-divider" />

        <!-- Mission section -->
        <section class="about-section">
          <h2 class="about-section-heading">Mission</h2>
          <p class="about-section-body">
            Physical AI is only as trustworthy as the layer beneath it. PUDA
            provides a typed, auditable middleware that makes every action
            traceable — from the LLM request to the actual instrument command —
            so researchers can iterate fast without sacrificing reproducibility
            or safety.
          </p>
        </section>

        <!-- Cards row -->
        <div class="about-cards">
          <div class="about-card">
            <span class="about-card-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="m8 9-4 3 4 3"/><path d="m16 9 4 3-4 3"/><path d="m14 5-4 14"/>
              </svg>
            </span>
            <span class="about-card-label">Open source</span>
            <p class="about-card-body">
              Core runtime and edge adapters are MIT-licensed and developed in
              the open on GitHub.
            </p>
            <a
              href="https://github.com/PUDAP"
              target="_blank"
              rel="noopener noreferrer"
              class="about-card-link"
            >
              github.com/PUDAP →
            </a>
          </div>

          <div class="about-card">
            <span class="about-card-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6Z"/><circle cx="12" cy="12" r="2.5"/><path d="M18.5 5.5 20 4"/>
              </svg>
            </span>
            <span class="about-card-label">Inspectable</span>
            <p class="about-card-body">
              Every agent turn, tool call, and hardware action is recorded and
              replayable — no black boxes.
            </p>
          </div>

          <div class="about-card">
            <span class="about-card-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5"/><path d="M9 13h7M9 17h5"/>
              </svg>
            </span>
            <span class="about-card-label">Research paper</span>
            <p class="about-card-body">
              PUDA: An AI-Native Hardware Harness for Self-Driving
              Laboratories — read the full paper on arXiv.
            </p>
            <a
              href="https://arxiv.org/abs/2607.26464"
              target="_blank"
              rel="noopener noreferrer"
              class="about-card-link"
            >
              arxiv.org/abs/2607.26464 →
            </a>
          </div>
        </div>

        <hr class="about-divider" />

        <!-- Contact section -->
        <section class="about-section">
          <h2 class="about-section-heading">Contact</h2>
          <p class="about-section-body">
            Questions, collaborations, or bug reports — reach out directly.
          </p>

          <div class="about-contact-grid">
            <a
              href="mailto:bearspuda@gmail.com"
              class="about-contact-card"
            >
              <span class="about-contact-icon">
                <!-- envelope -->
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </span>
              <div>
                <p class="about-contact-type">Email</p>
                <p class="about-contact-value">bearspuda@gmail.com</p>
              </div>
            </a>

            <a
              href="https://github.com/PUDAP"
              target="_blank"
              rel="noopener noreferrer"
              class="about-contact-card"
            >
              <span class="about-contact-icon">
                <!-- github mark -->
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"/>
                  <path d="M9 18c-4.51 2-5-2-7-2"/>
                </svg>
              </span>
              <div>
                <p class="about-contact-type">GitHub</p>
                <p class="about-contact-value">github.com/PUDAP</p>
              </div>
            </a>
          </div>
        </section>

      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .about-body {
    --about-surface: #030708;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--about-surface);
    color: var(--fg-primary);
  }

  [data-theme="light"] .about-body {
    --about-surface: #f5f7f2;
  }

  .about-main {
    flex: 1;
    position: relative;
    overflow: hidden;
    padding: 5rem 1.5rem 6rem;
    background-color: var(--about-surface);
  }

  /* Background layers */
  .about-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(73, 137, 163, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(73, 137, 163, 0.045) 1px, transparent 1px);
    background-size: 120px 120px;
    opacity: 0.45;
    pointer-events: none;
  }
  .about-radial-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 12% 10%, rgba(35, 95, 118, 0.1), transparent 34%),
      radial-gradient(circle at 88% 20%, rgba(44, 119, 155, 0.1), transparent 32%),
      radial-gradient(circle at 50% 100%, rgba(25, 70, 88, 0.07), transparent 38%);
    pointer-events: none;
  }
  .about-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 0%, rgba(0,0,0,0.24) 48%, rgba(0,0,0,0.76) 100%);
    pointer-events: none;
  }

  .about-circuit-bg {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    opacity: 0.34;
    background-image:
      url("/images/solutions-circuit-side.png"),
      url("/images/solutions-circuit-side.png");
    background-repeat: no-repeat;
    background-position: left -5rem top 8rem, right -6rem top 48rem;
    background-size: clamp(14rem, 20vw, 22rem) auto, clamp(13rem, 18vw, 20rem) auto;
    mix-blend-mode: screen;
    mask-image:
      linear-gradient(to bottom, transparent, #000 8rem, #000 calc(100% - 7rem), transparent),
      linear-gradient(to right, #000, transparent 30%, transparent 70%, #000);
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(to bottom, transparent, #000 8rem, #000 calc(100% - 7rem), transparent),
      linear-gradient(to right, #000, transparent 30%, transparent 70%, #000);
    -webkit-mask-composite: source-in;
  }

  /* Light mode: remove all decorative background layers */
  [data-theme="light"] .about-grid-bg,
  [data-theme="light"] .about-radial-bg,
  [data-theme="light"] .about-vignette {
    display: none;
  }

  [data-theme="light"] .about-circuit-bg {
    opacity: 0.12;
    mix-blend-mode: multiply;
  }

  /* Content wrapper */
  .about-content {
    position: relative;
    z-index: 10;
    max-width: 72rem;
    margin: 0 auto;
  }

  /* Label */
  .about-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.42em;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  /* Heading */
  .about-heading {
    font-size: clamp(3rem, 7.5vw, 6.5rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.065em;
    color: var(--fg-primary);
    margin: 0 0 2.25rem;
    max-width: 58rem;
  }

  /* Description */
  .about-description {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--fg-secondary);
    max-width: 46rem;
    margin: 0;
  }

  /* Divider */
  .about-divider {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    margin: 4rem 0;
  }
  [data-theme="light"] .about-divider {
    border-top-color: rgba(0, 0, 0, 0.09);
  }

  /* Sections */
  .about-section {
    margin-bottom: 0;
  }
  .about-section-heading {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.055em;
    color: var(--fg-primary);
    margin: 0 0 1.25rem;
  }
  .about-section-body {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--fg-secondary);
    margin: 0;
    max-width: 44rem;
  }

  /* Cards */
  .about-cards {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 2rem;
  }
  .about-card {
    border: 1px solid rgba(91, 164, 194, 0.2);
    border-radius: 0.75rem;
    padding: 1.4rem 1.5rem;
    background: linear-gradient(145deg, rgba(17, 34, 42, 0.96), rgba(7, 17, 22, 0.96));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: border-color 0.2s;
  }
  .about-card:hover {
    border-color: rgba(232, 255, 156, 0.42);
  }
  [data-theme="light"] .about-card {
    border-color: rgba(0, 0, 0, 0.08);
    background: rgba(0, 0, 0, 0.02);
  }
  [data-theme="light"] .about-card:hover {
    border-color: rgba(67, 114, 0, 0.25);
  }
  .about-card-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--accent);
  }
  .about-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.45rem;
    border: 1px solid rgba(91, 164, 194, 0.24);
    border-radius: 0.65rem;
    background: rgba(44, 119, 155, 0.1);
    color: #8bd3ea;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
  }
  .about-card:hover .about-card-icon {
    border-color: rgba(232, 255, 156, 0.36);
    color: #e8ff9c;
  }
  [data-theme="light"] .about-card-icon {
    border-color: rgba(35, 95, 118, 0.18);
    background: rgba(35, 95, 118, 0.06);
    color: #27677c;
  }
  .about-card-body {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--fg-secondary);
    margin: 0;
    flex: 1;
  }
  .about-card-link {
    font-size: 0.82rem;
    font-family: monospace;
    color: var(--accent);
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .about-card-link:hover {
    opacity: 0.75;
  }

  /* Contact grid */
  .about-contact-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    margin-top: 1.5rem;
  }
  .about-contact-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    border: 1px solid rgba(91, 164, 194, 0.2);
    border-radius: 0.75rem;
    padding: 1.25rem 1.4rem;
    background: linear-gradient(145deg, rgba(17, 34, 42, 0.96), rgba(7, 17, 22, 0.96));
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .about-contact-card:hover {
    border-color: rgba(232, 255, 156, 0.42);
    background: linear-gradient(145deg, rgba(20, 42, 50, 0.98), rgba(8, 20, 25, 0.98));
  }
  [data-theme="light"] .about-contact-card {
    border-color: rgba(0, 0, 0, 0.08);
    background: rgba(0, 0, 0, 0.02);
  }
  [data-theme="light"] .about-contact-card:hover {
    border-color: rgba(67, 114, 0, 0.25);
    background: rgba(67, 114, 0, 0.04);
  }
  .about-contact-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.5rem;
    background: rgba(232, 255, 156, 0.1);
    color: var(--accent);
  }
  [data-theme="light"] .about-contact-icon {
    background: rgba(67, 114, 0, 0.08);
  }
  .about-contact-type {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--accent);
    margin: 0 0 0.25rem;
  }
  .about-contact-value {
    font-size: 0.9rem;
    font-family: monospace;
    color: var(--fg-primary);
    margin: 0;
    word-break: break-all;
  }

  .about-hero {
    isolation: isolate;
    position: relative;
    min-height: 38rem;
    width: 100vw;
    margin-top: -5rem;
    margin-left: calc(50% - 50vw);
    margin-bottom: -1px;
    padding: clamp(7rem, 10vw, 9rem) max(1.5rem, calc((100vw - 72rem) / 2 + 1.5rem)) clamp(7rem, 9vw, 8rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .about-hero::before,
  .about-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .about-hero::before {
    z-index: -2;
    background: var(--about-surface) url("/images/about-physical-ai-hero.png") 58% center / cover no-repeat;
  }

  .about-hero::after {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(3, 7, 8, 0.97) 0%, rgba(3, 7, 8, 0.84) 44%, rgba(3, 7, 8, 0.15) 82%),
      linear-gradient(0deg, var(--about-surface) 0%, rgba(3, 7, 8, 0.94) 14%, transparent 38%, transparent 76%, rgba(3, 7, 8, 0.18) 100%);
  }

  .about-hero .about-label {
    color: #e8ff9c;
  }

  .about-hero .about-heading {
    color: #f3f5ef;
  }

  .about-hero .about-description {
    color: #b5c1c4;
  }

  @media (max-width: 900px) {
    .about-cards {
      grid-template-columns: 1fr;
    }

    .about-circuit-bg {
      display: none;
    }

    .about-hero {
      min-height: 36rem;
    }

    .about-hero::before {
      background-position: 65% center;
    }

    .about-hero::after {
      background: rgba(3, 7, 8, 0.8);
    }
  }
</style>
